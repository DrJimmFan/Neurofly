{
  "name": "neurofly",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner --host 127.0.0.1",
    "build": "tsc -b && vite build --configLoader runner",
    "preview": "vite preview --configLoader runner --host 127.0.0.1",
    "test": "vitest run --configLoader runner",
    "verify:asset": "node scripts/verify-asset.mjs",
    "format": "prettier --write src scripts/*.mjs vite.config.ts",
    "start": "node scripts/serve.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.19.3",
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@fontsource-variable/space-grotesk": "^5.2.10",
    "lucide-react": "0.468.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@types/node": "^22.18.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.9",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "4.7.0",
    "prettier": "^3.6.2",
    "typescript": "5.9.2",
    "vite": "6.3.5",
    "vitest": "3.2.4"
  }
}
